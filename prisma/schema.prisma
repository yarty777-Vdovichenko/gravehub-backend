// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  active
  blocked
}

enum Role {
  customer
  employee
}

enum EmployeeStatus {
  available
  busy
  offline
}

enum EmployeeMediaType {
  image
  video
}

enum NotificationType {
  proposal_received
  proposal_accepted
  proposal_rejected
  contract_status_changed
  new_message
}

enum ContractStatus {
  open
  in_progress
  awaiting_confirmation
  completed
  cancelled
}

enum ContractLocationType {
  coordinates
  burial_plot
  address
}

enum ProposalStatus {
  pending
  accepted
  rejected
  cancelled
}

model User {
  id                      String           @id @default(uuid())
  email                   String           @unique
  passwordHash            String
  name                    String
  status                  UserStatus
  createdAt               DateTime         @default(now())
  hashedRefreshToken      String?
  roles                   Role[]
  activeMode              Role
  employeeProfile         EmployeeProfile?
  emailVerified           Boolean          @default(false)
  contracts               Contract[]
  reviews                 Review[]
  reservedPlots           BurialPlot[]     @relation("PlotReservedBy")
  ownedPlots              BurialPlot[]     @relation("PlotOwner")
  plotPurchases           PlotPurchase[]
  tokens                  UserToken[]
  conversationsAsCustomer Conversation[]   @relation("ConversationCustomer")
  conversationsAsEmployee Conversation[]   @relation("ConversationEmployee")
  sentMessages            Message[]
  notifications           Notification[]
}

model EmployeeProfile {
  id                 String          @id @default(uuid())
  description        String
  regions            Region[]
  status             EmployeeStatus
  rating             Float           @default(0)
  completedContracts Int             @default(0)
  reviewsCount       Int             @default(0)
  userId             String          @unique
  user               User            @relation(fields: [userId], references: [id])
  specialization     Service[]
  portfolio          EmployeeMedia[]
  contracts          Contract[]
  proposals          Proposal[]
  reviews            Review[]
}

model EmployeeMedia {
  id         String            @id @default(uuid())
  employeeId String
  url        String
  publicId   String
  type       EmployeeMediaType
  caption    String?
  createdAt  DateTime          @default(now())
  employee   EmployeeProfile   @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, createdAt])
}

model Region {
  id        String            @id @default(uuid())
  name      String
  employees EmployeeProfile[]
  contracts Contract[]
}

model Contract {
  id           String               @id @default(uuid())
  title        String
  description  String
  customerId   String
  regionId     String
  locationType ContractLocationType @default(coordinates)
  positionX    Float?
  positionY    Float?
  address      String?
  burialPlotId String?
  date         DateTime
  budget       Float
  createdAt    DateTime             @default(now())
  employeeId   String?
  status       ContractStatus       @default(open)
  region       Region               @relation(fields: [regionId], references: [id])
  employee     EmployeeProfile?     @relation(fields: [employeeId], references: [id])
  customer     User                 @relation(fields: [customerId], references: [id])
  burialPlot   BurialPlot?          @relation(fields: [burialPlotId], references: [id])
  serviceTypes Service[]            @relation("ContractServices")
  proposals    Proposal[]
  review       Review?

  @@index([customerId])
  @@index([employeeId, status])
  @@index([regionId, status, createdAt])
}

model Service {
  id              String            @id @default(uuid())
  name            String
  description     String
  price           Float?
  parentId        String?
  parent          Service?          @relation("ServiceHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children        Service[]         @relation("ServiceHierarchy")
  employeeProfile EmployeeProfile[]
  contract        Contract[]        @relation("ContractServices")

  @@index([parentId])
}

model Proposal {
  id         String          @id @default(uuid())
  contractId String
  employeeId String
  price      Int
  comment    String
  status     ProposalStatus  @default(pending)
  createdAt  DateTime        @default(now())
  contract   Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  employee   EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([contractId, employeeId])
  @@index([employeeId])
  @@index([contractId, status])
}

enum PlotStatus {
  available
  reserved
  sold
}

model Cemetery {
  id        String       @id @default(uuid())
  name      String
  city      String
  latitude  Float
  longitude Float
  plots     BurialPlot[]
}

model BurialPlot {
  id            String        @id @default(uuid())
  cemeteryId    String
  positionX     Int
  positionY     Int
  price         Int
  status        PlotStatus    @default(available)
  reservedById  String?
  reservedUntil DateTime?
  ownerId       String?
  cemetery      Cemetery      @relation(fields: [cemeteryId], references: [id])
  reservedBy    User?         @relation("PlotReservedBy", fields: [reservedById], references: [id])
  owner         User?         @relation("PlotOwner", fields: [ownerId], references: [id])
  purchase      PlotPurchase?
  contracts     Contract[]

  @@unique([cemeteryId, positionX, positionY])
}

model PlotPurchase {
  id             String     @id @default(uuid())
  plotId         String     @unique
  userId         String
  price          Int
  paymentType    String
  creditMonths   Int?
  downPayment    Int?
  monthlyPayment Int?
  createdAt      DateTime   @default(now())
  plot           BurialPlot @relation(fields: [plotId], references: [id])
  user           User       @relation(fields: [userId], references: [id])
}

model Review {
  id         String          @id @default(uuid())
  contractId String          @unique
  employeeId String
  customerId String
  rating     Int
  text       String
  createdAt  DateTime        @default(now())
  contract   Contract        @relation(fields: [contractId], references: [id])
  employee   EmployeeProfile @relation(fields: [employeeId], references: [id])
  customer   User            @relation(fields: [customerId], references: [id])

  @@index([employeeId, createdAt])
}

enum TokenType {
  email_verification
  password_reset
}

model UserToken {
  id        String    @id @default(uuid())
  userId    String
  type      TokenType
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model Conversation {
  id            String    @id @default(uuid())
  customerId    String
  employeeId    String
  createdAt     DateTime  @default(now())
  lastMessageAt DateTime  @default(now())
  customer      User      @relation("ConversationCustomer", fields: [customerId], references: [id])
  employee      User      @relation("ConversationEmployee", fields: [employeeId], references: [id])
  messages      Message[]

  @@unique([customerId, employeeId])
  @@index([customerId, lastMessageAt])
  @@index([employeeId, lastMessageAt])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  text           String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  payload   Json
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}
